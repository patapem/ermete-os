{
  "athanor-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -ExecutionPolicy Bypass -File ./scripts/pre-commit-gate.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
