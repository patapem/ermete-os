<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">

<!--
  Azioni polkit di athanor-gatekeeper-rs.

  Nota 2026-09-02: i siti di chiamata in src/dbus.rs passano allow_user_interaction = true
  per approve e rollback (i default auth_admin* qui sotto sono raggiungibili) e false per
  deny, che è `yes` di proposito. Il controllo `polkit-subject` in scripts/verify.py
  segnala se questa combinazione regredisce.
-->
<policyconfig>
  <vendor>Athanor OS</vendor>
  <vendor_url>https://github.com/hr-mes/athanor-forge</vendor_url>

  <!-- Sblocca l'esecuzione di un binario messo in quarantena e lo avvia dentro una
       micro-VM. È il confine di sicurezza centrale del Gatekeeper.
       auth_admin_keep: una sessione di installazione fa più approvazioni di fila. -->
  <action id="os.athanor.gatekeeper.approve">
    <description>Approve execution of a quarantined program</description>
    <description xml:lang="it">Approvare l'esecuzione di un programma in quarantena</description>
    <message>Authentication is required to allow a quarantined program to run.</message>
    <message xml:lang="it">È richiesta l'autenticazione per consentire l'esecuzione di un programma in quarantena.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- Rifiutare un'esecuzione non deve mai avere attrito: se negare richiedesse
       una password, un utente in dubbio finirebbe per approvare. Proprietà di
       sicurezza deliberata, non una svista. -->
  <action id="os.athanor.gatekeeper.deny">
    <description>Refuse execution of a quarantined program</description>
    <description xml:lang="it">Rifiutare l'esecuzione di un programma in quarantena</description>
    <message>Refusing execution never requires authentication.</message>
    <message xml:lang="it">Rifiutare un'esecuzione non richiede mai autenticazione.</message>
    <defaults>
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- Ripristina uno snapshot bcachefs di /var/home: distrugge le modifiche fatte
       dopo lo snapshot. Distruttivo sui dati dell'utente, mai in cache. -->
  <action id="os.athanor.gatekeeper.rollback">
    <description>Roll back the home subvolume to a snapshot</description>
    <description xml:lang="it">Ripristinare il sottovolume home a uno snapshot</description>
    <message>Authentication is required to roll back your home directory, discarding changes made since the snapshot.</message>
    <message xml:lang="it">È richiesta l'autenticazione per ripristinare la cartella home, scartando le modifiche fatte dopo lo snapshot.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <!-- Elevazione a root. Mai auth_admin_keep: un'autorizzazione a diventare root
       non si ricorda per i minuti successivi. -->
  <action id="os.athanor.gatekeeper.root">
    <description>Request root privileges</description>
    <description xml:lang="it">Richiedere i privilegi di root</description>
    <message>Authentication is required to grant root privileges.</message>
    <message xml:lang="it">È richiesta l'autenticazione per concedere i privilegi di root.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

</policyconfig>
