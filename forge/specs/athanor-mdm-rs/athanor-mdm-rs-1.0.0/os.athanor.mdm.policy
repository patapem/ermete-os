<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">

<!--
  Azioni polkit di athanor-mdm-rs.

  Aggiunta 2026-09-02: "os.athanor.mdm.apply_policy" è applicata in src/main.rs:118
  ma non era dichiarata, quindi ogni applicazione di policy MDM veniva negata.
  Vedi ANALISI_2026-09-02.md §2.1.
-->
<policyconfig>
  <vendor>Athanor OS</vendor>
  <vendor_url>https://github.com/hr-mes/athanor-forge</vendor_url>

  <action id="os.athanor.mdm.wipe">
    <description>Trigger Cryptographic Device Wipe</description>
    <description xml:lang="it">Avviare la cancellazione crittografica del dispositivo</description>
    <message>Authentication is required to permanently erase all data on this device.</message>
    <message xml:lang="it">È richiesta l'autenticazione per cancellare in modo permanente tutti i dati su questo dispositivo.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- Applica un payload di policy di gestione remota: cambia configurazione di
       sistema per conto di un amministratore di flotta. Mai in cache. -->
  <action id="os.athanor.mdm.apply_policy">
    <description>Apply a device management policy</description>
    <description xml:lang="it">Applicare una policy di gestione del dispositivo</description>
    <message>Authentication is required to apply a device management policy.</message>
    <message xml:lang="it">È richiesta l'autenticazione per applicare una policy di gestione del dispositivo.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

</policyconfig>
