<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">

<!--
  Azioni polkit di athanor-daemon-rs.

  Prima che questo file esistesse, le cinque azioni qui sotto erano applicate dal
  codice ma non dichiarate da nessuna parte: CheckAuthorization su un action-id non
  registrato non autorizza, il codice mappa quel caso su AccessDenied, e il risultato
  era che sul sistema installato Settings non poteva configurare la rete né accendere
  il Bluetooth. Vedi ANALISI_2026-09-02.md §2.1.

  I default seguono le convenzioni di NetworkManager per le operazioni equivalenti:
  ciò che tocca solo la sessione dell'utente è `yes` per la sessione attiva; ciò che
  crea configurazione di sistema o inietta codice richiede autenticazione admin.
-->
<policyconfig>
  <vendor>Athanor OS</vendor>
  <vendor_url>https://github.com/hr-mes/athanor-forge</vendor_url>

  <!-- Aspetto e tema: stato della sessione dell'utente, non privilegiato. -->
  <action id="os.athanor.settings.change">
    <description>Change desktop settings</description>
    <description xml:lang="it">Modificare le impostazioni del desktop</description>
    <message>Authentication is required to change desktop settings.</message>
    <message xml:lang="it">È richiesta l'autenticazione per modificare le impostazioni del desktop.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- Volume di sistema: reversibile, senza conseguenze di sicurezza. -->
  <action id="os.athanor.bedrock.setvolume">
    <description>Change the system volume</description>
    <description xml:lang="it">Modificare il volume di sistema</description>
    <message>Authentication is required to change the system volume.</message>
    <message xml:lang="it">È richiesta l'autenticazione per modificare il volume di sistema.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- Alimentazione dell'adattatore Bluetooth: effetto su tutta la macchina, ma
       reversibile e atteso dall'utente seduto davanti. -->
  <action id="os.athanor.bluetooth.setpower">
    <description>Turn the Bluetooth adapter on or off</description>
    <description xml:lang="it">Accendere o spegnere l'adattatore Bluetooth</description>
    <message>Authentication is required to change the Bluetooth adapter state.</message>
    <message xml:lang="it">È richiesta l'autenticazione per cambiare lo stato dell'adattatore Bluetooth.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- Crea connessioni NetworkManager di sistema, incluse 802.1x EAP e VPN.
       Equivale a org.freedesktop.NetworkManager.settings.modify.system, che
       upstream marca auth_admin_keep. -->
  <action id="os.athanor.network.configure">
    <description>Configure network connections</description>
    <description xml:lang="it">Configurare le connessioni di rete</description>
    <message>Authentication is required to create or modify a system network connection.</message>
    <message xml:lang="it">È richiesta l'autenticazione per creare o modificare una connessione di rete di sistema.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- Carica una libreria condivisa dentro un daemon in esecuzione: è esecuzione
       di codice arbitrario nel processo. Deliberatamente auth_admin e non
       auth_admin_keep: un'autorizzazione a iniettare codice non si mette in cache. -->
  <action id="os.athanor.livepatcher.apply">
    <description>Apply a live patch to a running daemon</description>
    <description xml:lang="it">Applicare un live patch a un daemon in esecuzione</description>
    <message>Authentication is required to load new code into a running system daemon.</message>
    <message xml:lang="it">È richiesta l'autenticazione per caricare nuovo codice in un daemon di sistema in esecuzione.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

</policyconfig>
