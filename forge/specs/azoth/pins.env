# Pin del kernel Athanor. Letto da build.sh, aggiornato dal bot di bump (fase K5).
# Ogni file che questi pin identificano ha il proprio hash in SOURCES/sources.sha256.
# Vedi docs/architecture/doc_kernel_build.md, sezione 2.

# SRPM Fedora da koji: la build stable con lo stesso patch level di CACHYOS_RELEASE,
# perche' il diff base entra solo nell'albero da cui e' stato calcolato.
FEDORA_KERNEL_NVR=7.1.8-100.fc43
# Impronta della chiave di firma della release, la stessa che l'immagine base spedisce
# in /etc/pki/rpm-gpg: gli ultimi 8 esadecimali sono la directory sigcache di koji.
FEDORA_KEY_FPR=c6e7f081cf80e13146676e88829b606631645531

# stable segue l'ultima serie che Fedora e CachyOS spediscono entrambe; lts la 6.18.
KERNEL_CHANNEL=stable

# Albero CachyOS (release GitHub firmata) della stessa serie: la base Athanor è il
# diff tra il tarball vanilla di quel patch level e questo tarball.
CACHYOS_RELEASE=cachyos-7.1.8-1

# Commit di CachyOS/linux-cachyos da cui viene linux-cachyos/config: le opzioni
# Kconfig introdotte dalla base prendono i valori di quel config.
CACHYOS_CONFIG_COMMIT=4e397a4e5a703fc2f905b73eb60e0a772654317b

# Commit di CachyOS/kernel-patches da cui vengono le patch di patches.list.
CACHYOS_PATCHES_COMMIT=7617649ec3fee6e42a9eaf9c3585c2ae79c5db00

# Moduli kernel NVIDIA (sezione 10, fase K4), fuori dagli input del kernel: non
# cambiano gli RPM del kernel e non invalidano il riuso (build-inputs.py li esclude).
# open: GitHub NVIDIA/open-gpu-kernel-modules, il tag e' annotato e puo' muoversi, il
# commit no: nvidia.sh verifica il commit. legacy: il .run proprietario del ramo 580
# (Maxwell, Pascal, Volta), pinnato per sha256 in nvidia/sources.sha256, non nel manifest
# del kernel: build.sh verifica quello per intero, e il suo hash e' un input del riuso.
NVIDIA_OPEN_VERSION=610.57.04
NVIDIA_OPEN_COMMIT=e4a5faa2567f28c8eabe0ebb6422b6d0abcf37eb
NVIDIA_LEGACY_VERSION=580.178.04
