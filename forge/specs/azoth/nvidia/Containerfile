# Athanor OS: ambiente dei moduli kernel NVIDIA (docs/architecture/doc_kernel_build.md,
# sezione 10, fase K4). Stessa base pinnata del builder del kernel, ma solo cio' che
# serve a nvidia.sh: la toolchain LLVM con cui e' compilato il kernel (kCFI), Kbuild
# dall'albero kernel-devel estratto dal RPM, kmod per modinfo, openssl e sign-file per
# la firma. Niente rust, pahole o koji: e' un'immagine piu' piccola e piu' veloce del
# builder, e non tocca il suo Containerfile (che e' un input del riuso del kernel).
FROM registry.fedoraproject.org/fedora:43@sha256:396ef5b431dec0e4c5b1aa3bc2508f02b1270e798dda073b8c813cc637c6884c

RUN printf 'install_weak_deps=False\nkeepcache=False\n' >> /etc/dnf/dnf.conf

RUN dnf -y install \
      clang lld llvm make gcc elfutils-libelf-devel \
      rpm cpio curl git kmod openssl findutils diffutils \
    && dnf clean all
